data $echofmts = { b "%s\n", b 0 }
data $echofmtd = { b "%d\n", b 0 }
data $fmtd = { b "%d", b 0 }
data $fmts = { b "%s", b 0 }
data $test = { b "%p %p\n", b 0 }

function l $__add(l %x, l %c) {
	@start
	%o =l add %x, %c
	ret %o
}

function l $__sub(l %x, l %c) {
	@start
	%o =l sub %x, %c
	ret %o
}

function l $__mul(l %x, l %c) {
	@start
	%o =l mul %x, %c
	ret %o
}

function l $__div(l %x, l %c) {
	@start
	%o =l div %x, %c
	ret %o
}

function l $__mod(l %x, l %c) {
	@start
	%o =l rem %x, %c
	ret %o
}

function l $__itoa(l %x) {
	@start
		%X0 =l alloc4 8
		call $sprintf(l %X0, l $fmtd, l %x)
		ret %X0
}

function l $__idx(l %X0) {
	@start
	%X1 =l add %X0, 1
	call $printf(l $test, l %X0, l %X1)
	ret 0
}

function l $__val(l %addr) {
	@start
	%x =l loadl %addr
	ret %x
}
