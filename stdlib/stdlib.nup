fun add(a: int, b: int) -> int is
	result: int := __add(a, b)
	return result
end

fun sub(a: int, b: int) -> int is
	result: int := __sub(a, b)
	return result
end

fun mul(a: int, b: int) -> int is
	result: int := __mul(a, b)
	return result
end

fun div(a: int, b: int) -> int is
	result: int := __div(a, b)
	return result
end

fun echo(s: str) -> none is
	printf("%s\n", s)
	return 0
end

fun itoa(num: int) -> str is
	return __itoa(num)
end
