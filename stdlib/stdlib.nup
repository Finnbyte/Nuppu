fun add(a: int, b: int) is
	let result: int = __add(a, b)
	return result
end

fun sub(a: int, b: int) is
	let result: int = __sub(a, b)
	return result
end

fun mul(a: int, b: int) is
	let result: int = __mul(a, b)
	return result
end

fun div(a: int, b: int) is
	let result: int = __div(a, b)
	return result
end

fun echo(s: str) is
	printf("%s\n", s)
	return 0
end

fun itoa(num: int) is
	return __itoa(num)
end
